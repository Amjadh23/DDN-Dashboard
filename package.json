{
  "name": "dasar-dadah-collaborative-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format": "prettier --write src tests scripts database package.json tsconfig.json next.config.ts eslint.config.mjs",
    "format:check": "prettier --check src tests scripts database package.json tsconfig.json next.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:db": "tsx --env-file=.env.local --test tests/database/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "worker": "tsx --conditions=react-server --env-file=.env.local src/worker/run.ts",
    "worker:once": "tsx --conditions=react-server --env-file=.env.local src/worker/run.ts --once",
    "qa:visual": "tsx scripts/visual-qa.ts"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/d3-geo": "3.1.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
